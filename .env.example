# TFI-banisa configuration — copy to .env and `source .env`, or export in shell.
# Every variable is optional; defaults shown.

# Root data directory (images, SQLite DB, Qdrant data, logs)
#TFIBANISA_HOME=~/.tfibanisa

# Qdrant: "embedded" runs in-process (no Docker), "server" connects to QDRANT_URL
#QDRANT_MODE=embedded
#QDRANT_URL=http://localhost:6333
#QDRANT_PATH=~/.tfibanisa/qdrant
#QDRANT_COLLECTION=telugu_memes

# Models (HuggingFace IDs)
#EMBEDDING_MODEL=krutrim-ai-labs/Vyakyarth
#EMBEDDING_DIM=768
#CAPTION_MODEL=microsoft/Florence-2-base
#CAPTION_TASK=<DETAILED_CAPTION>   # or <CAPTION> (faster) / <MORE_DETAILED_CAPTION> (richer)
#OCR_LANG=tel+eng

# Server
#HOST=0.0.0.0
#PORT=8000
#MAX_UPLOAD_MB=10
#LOG_LEVEL=INFO

# Background jobs
#JOB_MAX_RETRIES=2
